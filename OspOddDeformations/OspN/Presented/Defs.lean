import OspOddDeformations.OspN.Basis
import Mathlib.Algebra.RingQuot
import Mathlib.Algebra.FreeAlgebra

/-!
# The source algebra presented by generators and relations

The paper's `A_β` (eq. (2.1)) is the unital associative superalgebra over `R = P ⊕ κP` generated by
even `b_u` and odd `a_i`, subject to `[b_u,b_v] = J_{uv}`, `{a_i,a_j} = g_{ij}`,
`[b_u,a_i] = β_{u,i}κ`. The odd scalar `κ` is not central (`a_iκ = −κa_i`), so `A_β` is built as a
`P`-algebra (`P` central) with `κ` among its generators: `Src J g β` is the quotient of the free
`P`-algebra on `b_u`, `a_i`, `κ` by those relations together with `κ² = 0`, `κb_u = b_uκ` and
`κa_i = −a_iκ`. The grading is the involution `parity` (`b ↦ b`, `a ↦ −a`, `κ ↦ −κ`).

`Src` is a type synonym carrying only `Ring` and `Algebra` instances: `RingQuot`'s own `Neg`
instance is not found by `rw [mul_neg]`.

The paper's instance is `ABeta F n` (with `β = beta F n`) and `AZero F n` (with `β = 0`).
-/

namespace OspOddDeformations
namespace OspN
namespace Presented

variable {P : Type} [CommRing P] {I K : Type}

/-- The generators: `b u`, `a i` and `κ`. -/
abbrev Gen (I K : Type) := I ⊕ K ⊕ Unit

/-- The generator `b_u` in the free algebra. -/
def bF (u : I) : FreeAlgebra P (Gen I K) := FreeAlgebra.ι P (Sum.inl u)
/-- The generator `a_i` in the free algebra. -/
def aF (i : K) : FreeAlgebra P (Gen I K) := FreeAlgebra.ι P (Sum.inr (Sum.inl i))
/-- The generator `κ` in the free algebra. -/
def kF : FreeAlgebra P (Gen I K) := FreeAlgebra.ι P (Sum.inr (Sum.inr ()))

/-- The relations of eq. (2.1), with `κ` odd and supercentral and `κ² = 0`. -/
inductive Rel (J : I → I → P) (g : K → K → P) (β : I → K → P) :
    FreeAlgebra P (Gen I K) → FreeAlgebra P (Gen I K) → Prop
  | bb (u v : I) : Rel J g β (bF u * bF v) (bF v * bF u + algebraMap P _ (J u v))
  | aa (i j : K) : Rel J g β (aF i * aF j + aF j * aF i) (algebraMap P _ (g i j))
  | ba (u : I) (i : K) : Rel J g β (bF u * aF i) (aF i * bF u + β u i • kF)
  | kk : Rel J g β (kF * kF) 0
  | kb (u : I) : Rel J g β (kF * bF u) (bF u * kF)
  | ka (i : K) : Rel J g β (kF * aF i + aF i * kF) 0

/-- The presented source algebra. -/
def Src (J : I → I → P) (g : K → K → P) (β : I → K → P) : Type := RingQuot (Rel J g β)

instance (J : I → I → P) (g : K → K → P) (β : I → K → P) : Ring (Src J g β) :=
  inferInstanceAs (Ring (RingQuot _))

instance (J : I → I → P) (g : K → K → P) (β : I → K → P) : Algebra P (Src J g β) :=
  inferInstanceAs (Algebra P (RingQuot _))

variable (J : I → I → P) (g : K → K → P) (β : I → K → P)

/-- The quotient map. -/
def mk : FreeAlgebra P (Gen I K) →ₐ[P] Src J g β := RingQuot.mkAlgHom P (Rel J g β)

/-- `b_u`. -/
def b (u : I) : Src J g β := mk J g β (bF u)
/-- `a_i`. -/
def a (i : K) : Src J g β := mk J g β (aF i)
/-- `κ`. -/
def κ : Src J g β := mk J g β kF

variable {J g β}

theorem mk_rel {x y : FreeAlgebra P (Gen I K)} (h : Rel J g β x y) : mk J g β x = mk J g β y :=
  RingQuot.mkAlgHom_rel P h

theorem b_mul_b (u v : I) :
    b J g β u * b J g β v = b J g β v * b J g β u + algebraMap P _ (J u v) := by
  simpa [b, map_mul, map_add, AlgHom.commutes] using mk_rel (J := J) (g := g) (β := β) (Rel.bb u v)
theorem a_mul_a_add (i j : K) :
    a J g β i * a J g β j + a J g β j * a J g β i = algebraMap P _ (g i j) := by
  simpa [a, map_mul, map_add, AlgHom.commutes] using mk_rel (J := J) (g := g) (β := β) (Rel.aa i j)
theorem b_mul_a (u : I) (i : K) :
    b J g β u * a J g β i = a J g β i * b J g β u + β u i • κ J g β := by
  simpa [a, b, κ, map_mul, map_add, map_smul] using
    mk_rel (J := J) (g := g) (β := β) (Rel.ba u i)
theorem κ_mul_κ : κ J g β * κ J g β = 0 := by
  simpa [κ, map_mul] using mk_rel (J := J) (g := g) (β := β) Rel.kk
theorem κ_mul_b (u : I) : κ J g β * b J g β u = b J g β u * κ J g β := by
  simpa [κ, b, map_mul] using mk_rel (J := J) (g := g) (β := β) (Rel.kb u)
theorem κ_mul_a (i : K) : κ J g β * a J g β i = -(a J g β i * κ J g β) := by
  have h := mk_rel (J := J) (g := g) (β := β) (Rel.ka i)
  simp only [map_mul, map_add, map_zero] at h
  exact eq_neg_of_add_eq_zero_left h

/-- A map out of `Src` given on generators that satisfy the relations (the universal property). -/
def liftSrc {A : Type} [Ring A] [Algebra P A] (f : Gen I K → A)
    (h : ∀ x y, Rel J g β x y → FreeAlgebra.lift P f x = FreeAlgebra.lift P f y) :
    Src J g β →ₐ[P] A :=
  RingQuot.liftAlgHom P ⟨FreeAlgebra.lift P f, h⟩

theorem liftSrc_mk {A : Type} [Ring A] [Algebra P A] (f : Gen I K → A)
    (h : ∀ x y, Rel J g β x y → FreeAlgebra.lift P f x = FreeAlgebra.lift P f y)
    (x : FreeAlgebra P (Gen I K)) :
    liftSrc f h (mk J g β x) = FreeAlgebra.lift P f x :=
  RingQuot.liftAlgHom_mkAlgHom_apply P _ _ _

/-- Two maps out of `Src` that agree on the generators are equal. -/
theorem algHom_ext {A : Type} [Ring A] [Algebra P A] {φ ψ : Src J g β →ₐ[P] A}
    (hb : ∀ u, φ (b J g β u) = ψ (b J g β u)) (ha : ∀ i, φ (a J g β i) = ψ (a J g β i))
    (hκ : φ (κ J g β) = ψ (κ J g β)) : φ = ψ := by
  apply RingQuot.ringQuot_ext'
  apply FreeAlgebra.hom_ext
  funext x
  rcases x with u | i | _
  · exact hb u
  · exact ha i
  · exact hκ

/-- The images of the generators under `parity`. -/
def parityGen : Gen I K → Src J g β
  | Sum.inl u => b J g β u
  | Sum.inr (Sum.inl i) => -a J g β i
  | Sum.inr (Sum.inr _) => -κ J g β

theorem parityGen_rel (x y : FreeAlgebra P (Gen I K)) (h : Rel J g β x y) :
    FreeAlgebra.lift P (parityGen (J := J) (g := g) (β := β)) x
      = FreeAlgebra.lift P parityGen y := by
  cases h with
  | bb u v =>
    simp only [map_mul, map_add, AlgHom.commutes, bF, FreeAlgebra.lift_ι_apply, parityGen]
    exact b_mul_b u v
  | aa i j =>
    simp only [map_mul, map_add, AlgHom.commutes, aF, FreeAlgebra.lift_ι_apply, parityGen,
      neg_mul_neg]
    exact a_mul_a_add i j
  | ba u i =>
    simp only [map_mul, map_add, map_smul, aF, bF, kF, FreeAlgebra.lift_ι_apply, parityGen,
      mul_neg, neg_mul, smul_neg]
    rw [b_mul_a, neg_add]
  | kk =>
    simp only [map_mul, map_zero, kF, FreeAlgebra.lift_ι_apply, parityGen, neg_mul_neg]
    exact κ_mul_κ
  | kb u =>
    simp only [map_mul, kF, bF, FreeAlgebra.lift_ι_apply, parityGen, neg_mul, mul_neg]
    rw [κ_mul_b]
  | ka i =>
    simp only [map_mul, map_add, map_zero, kF, aF, FreeAlgebra.lift_ι_apply, parityGen,
      neg_mul_neg]
    rw [κ_mul_a, neg_add_cancel]

/-- The grading automorphism: `b ↦ b`, `a ↦ −a`, `κ ↦ −κ`. An element is even when `parity`
fixes it, odd when `parity` negates it. -/
def parity : Src J g β →ₐ[P] Src J g β := liftSrc parityGen parityGen_rel

theorem parity_b (u : I) : parity (b J g β u) = b J g β u := by
  simp only [parity, b, liftSrc_mk, bF, FreeAlgebra.lift_ι_apply, parityGen]
theorem parity_a (i : K) : parity (a J g β i) = -a J g β i := by
  simp only [parity, a, liftSrc_mk, aF, FreeAlgebra.lift_ι_apply, parityGen]
theorem parity_κ : parity (κ J g β) = -κ J g β := by
  simp only [parity, κ, liftSrc_mk, kF, FreeAlgebra.lift_ι_apply, parityGen]

/-! ## The paper's instance -/

/-- `J` with values in `P`. -/
noncomputable def jP (F : FermionIndex) (n : ℕ) (u v : Bmn.I n) : Pmn F n :=
  algebraMap ℚ (Pmn F n) (Bmn.J n u v)

/-- `g` with values in `P`. -/
noncomputable def gP (F : FermionIndex) (n : ℕ) (i j : F.K) : Pmn F n :=
  algebraMap ℚ (Pmn F n) (F.g i j)

/-- `A_β`, eq. (2.1). -/
abbrev ABeta (F : FermionIndex) (n : ℕ) : Type := Src (jP F n) (gP F n) (beta F n)

/-- `A_0`, eq. (2.1) at `β = 0`. -/
abbrev AZero (F : FermionIndex) (n : ℕ) : Type := Src (jP F n) (gP F n) 0

end Presented
end OspN
end OspOddDeformations
